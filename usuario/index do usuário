<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<title>Dominus Auto — Minha Conta</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --teal-petroleo:#06333E;
    --teal-soft:#529EAF;
    --gold:#C6A253;
    --cream:#EFE9DA;
    --white:#FFFFFF;
    --gray-bg:#EFEFEF;
    --text-dark:#1C1C1C;
    --text-gray:#4A4A4A;
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  body{
    font-family:'Inter', sans-serif;
    background:#dcdcdc;
    color:var(--text-dark);
  }

  .section-label{
    max-width:1456px;
    margin:0 auto;
    padding:36px 40px 14px;
    font-family:'Inter',sans-serif;
    font-size:13px;
    letter-spacing:.08em;
    color:#6b6b6b;
    text-transform:uppercase;
  }

  .page{
    width:1456px;
    max-width:100%;
    margin:0 auto 48px;
    background:var(--gray-bg);
    box-shadow:0 10px 30px rgba(0,0,0,.15);
    overflow:hidden;
    min-height:600px;
  }

  /* ---------- HEADER (igual à Home) ---------- */
  header{
    background:var(--teal-petroleo);
    height:88px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0 44px;
  }
  .brand{display:flex;align-items:center;gap:14px;}
  .brand-icon{
    width:38px;height:38px;
    display:grid;
    grid-template-columns:1fr 1fr;
    grid-template-rows:1fr 1fr;
    flex-shrink:0;
  }
  .brand-icon span{display:block;}
  .bi-tl{background:var(--gold);border-radius:2px 0 0 0;}
  .bi-tr{background:var(--cream);border-radius:100% 0 0 0;}
  .bi-bl{background:var(--teal-soft);border-radius:0 0 0 100%;}
  .bi-br{background:var(--gold);border-radius:0 0 100% 0;}
  .brand-text{display:flex;flex-direction:column;line-height:1;}
  .brand-text .b1{
    font-family:'Poppins',sans-serif;font-weight:500;font-size:19px;
    letter-spacing:.22em;color:var(--gold);
  }
  .brand-text .b2{
    font-family:'Poppins',sans-serif;font-weight:400;font-size:9px;
    letter-spacing:.32em;color:#9AA9AC;margin-top:4px;
  }
  nav.mainnav{display:flex;align-items:center;gap:40px;}
  nav.mainnav a{
    color:var(--white);text-decoration:none;
    font-family:'Poppins',sans-serif;font-size:15px;font-weight:400;
    padding-bottom:6px;
  }
  .avatar-photo{
    width:40px;height:40px;border-radius:50%;
    object-fit:cover;border:2px solid var(--white);
  }

  /* ---------- CONTEÚDO / CARDS DE CONTA ---------- */
  .account-wrap{
    padding:70px 0;
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:60px;
  }

  .account-card{
    width:640px;
    max-width:90%;
    background:var(--gray-bg);
    border:1.5px solid var(--gold);
    border-radius:22px;
    padding:36px 40px 44px;
  }
  .account-card h2{
    font-family:'Poppins',sans-serif;
    font-weight:600;
    font-size:24px;
    color:var(--text-dark);
    margin-bottom:26px;
  }

  .field-block{margin-bottom:22px;}
  .field-header{
    display:flex;
    align-items:center;
    gap:10px;
    background:var(--white);
    border:1px solid var(--gold);
    border-radius:8px 8px 0 0;
    padding:12px 16px;
  }
  .field-header .icon{
    width:26px;height:26px;
    background:var(--teal-soft);
    border-radius:5px;
    display:flex;align-items:center;justify-content:center;
    flex-shrink:0;
  }
  .field-header .icon svg{width:15px;height:15px;stroke:var(--white);fill:none;stroke-width:1.8;}
  .field-header span{
    font-family:'Poppins',sans-serif;
    font-weight:600;
    font-size:15px;
    color:var(--text-dark);
  }

  .field-body{
    background:var(--white);
    border:1px solid var(--gold);
    border-top:none;
    border-radius:0 0 8px 8px;
    padding:14px 16px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:16px;
    font-family:'Inter',sans-serif;
    font-size:14px;
    color:#333;
  }
  .field-body.static-value{color:#333;}

  .btn-teal{
    background:var(--teal-soft);
    color:var(--white);
    border:none;
    font-family:'Poppins',sans-serif;
    font-weight:600;
    font-size:13px;
    padding:9px 18px;
    border-radius:5px;
    cursor:pointer;
    white-space:nowrap;
  }

  .toggle-row{
    display:flex;
    align-items:center;
    gap:12px;
  }
  .toggle{
    width:38px;height:20px;
    background:var(--teal-soft);
    border-radius:20px;
    position:relative;
    flex-shrink:0;
  }
  .toggle::after{
    content:"";
    position:absolute;
    top:2px;right:2px;
    width:16px;height:16px;
    background:var(--white);
    border-radius:50%;
  }
  .toggle .check{
    position:absolute;
    left:3px;top:50%;
    transform:translateY(-50%);
    width:10px;height:10px;
  }
  .toggle .check svg{width:100%;height:100%;stroke:var(--white);fill:none;stroke-width:3;}

  .stacked-toggles{display:flex;flex-direction:column;gap:14px;width:100%;}
  .stacked-toggles .toggle-row{justify-content:flex-start;}
</style>
</head><!-- ============================================================ -->
<!-- INDEX DO USUÁRIO — Minha Conta -->
<!-- ============================================================ -->
<div class="section-label">Minha Conta — Dados e Segurança / Informações da Conta</div>
<div class="page">

  <header>
    <div class="brand">
      <div class="brand-icon">
        <span class="bi-tl"></span><span class="bi-tr"></span>
        <span class="bi-bl"></span><span class="bi-br"></span>
      </div>
      <div class="brand-text">
        <span class="b1">DOMINUS</span>
        <span class="b2">AUTO</span>
      </div>
    </div>

    <nav class="mainnav">
      <a href="#">Home</a>
      <a href="#">Veículos</a>
      <a href="#">Suporte</a>
      <a href="#">Sobre Nós</a>
    </nav>

    <div class="header-right">
      <img class="avatar-photo" src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&w=100&q=80" alt="Foto de perfil">
    </div>
  </header>

  <div class="account-wrap">

    <!-- ===== CARD 1: DADOS E SEGURANÇA ===== -->
    <div class="account-card">
      <h2>Dados e Segurança</h2>

      <div class="field-block">
        <div class="field-header">
          <div class="icon">
            <svg viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
          </div>
          <span>Segurança e acesso e senha</span>
        </div>
        <div class="field-body">
          <span>Ultima alteração: xx/yy/zzzz</span>
          <button class="btn-teal">Alterar senha</button>
        </div>
      </div>

      <div class="field-block">
        <div class="field-header">
          <div class="icon">
            <svg viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="16" rx="2"/><circle cx="9" cy="10" r="2"/><path d="M6 17c.5-2 2-3 3-3s2.5 1 3 3"/><path d="M14 9h4M14 13h4"/></svg>
          </div>
          <span>Informações da conta</span>
        </div>
        <div class="field-body">
          <span></span>
          <button class="btn-teal">Verificar dados</button>
        </div>
      </div>

      <div class="field-block">
        <div class="field-header">
          <div class="icon">
            <svg viewBox="0 0 24 24"><rect x="6" y="2" width="12" height="20" rx="2"/><path d="M11 18h2"/></svg>
          </div>
          <span>Verificação de Duas Etapas</span>
        </div>
        <div class="field-body">
          <div class="toggle-row">
            <div class="toggle"><div class="check"><svg viewBox="0 0 24 24"><path d="m5 13 4 4 10-10"/></svg></div></div>
            <span>Ativada</span>
          </div>
        </div>
      </div>

      <div class="field-block">
        <div class="field-header">
          <div class="icon">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6 8-6s8 2 8 6"/><path d="M18 14l2 2-3 3"/></svg>
          </div>
          <span>Preferências de Privacidade</span>
        </div>
        <div class="field-body">
          <div class="stacked-toggles">
            <div class="toggle-row">
              <div class="toggle"><div class="check"><svg viewBox="0 0 24 24"><path d="m5 13 4 4 10-10"/></svg></div></div>
              <span>Receber Emails Exclusivos</span>
            </div>
            <div class="toggle-row">
              <div class="toggle"><div class="check"><svg viewBox="0 0 24 24"><path d="m5 13 4 4 10-10"/></svg></div></div>
              <span>Preferência de Cookies</span>
            </div>
          </div>
        </div>
      </div>
    </div>    <!-- ===== CARD 2: INFORMAÇÕES DA CONTA ===== -->
    <div class="account-card">
      <h2>Informações da Conta</h2>

      <div class="field-block">
        <div class="field-header">
          <div class="icon">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6 8-6s8 2 8 6"/></svg>
          </div>
          <span>Nome Completo</span>
        </div>
        <div class="field-body static-value">
          <span>Fulano de tal</span>
        </div>
      </div>

      <div class="field-block">
        <div class="field-header">
          <div class="icon">
            <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>
          </div>
          <span>Data de Nascimento</span>
        </div>
        <div class="field-body static-value">
          <span>xx/yy/zzzz</span>
        </div>
      </div>

      <div class="field-block">
        <div class="field-header">
          <div class="icon">
            <svg viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M8 9h8M8 13h5M8 17h3"/></svg>
          </div>
          <span>CPF</span>
        </div>
        <div class="field-body static-value">
          <span>XXX.XXX.XXX-YY</span>
        </div>
      </div>

      <div class="field-block">
        <div class="field-header">
          <div class="icon">
            <svg viewBox="0 0 24 24"><path d="M4 5c0 8 7 15 15 15l3-4-6-3-2 2c-2-1-4-3-5-5l2-2-3-6Z"/></svg>
          </div>
          <span>Telefone</span>
        </div>
        <div class="field-body static-value">
          <span>+XX YY ZZZZ-ZZZZ</span>
        </div>
      </div>
    </div>

  </div>
</div>

</body>
</html>
<body>
